# ── Provider keys (the Director's three keys) ──────────────────────────────
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=

# ── Model IDs (upgradeable without code changes) ───────────────────────────
OPENAI_MODEL=             # Director/Producer + Art Director (visuals)
ANTHROPIC_MODEL=          # Writer (story + technical)
GOOGLE_MODEL=             # Critic (multimodal review)
TRANSCRIBE_MODEL=         # voice transcription (e.g. whisper)

# ── Image generation ───────────────────────────────────────────────────────
COMFYUI_URL=http://localhost:8188

# ── Infrastructure ─────────────────────────────────────────────────────────
DATABASE_URL=postgresql+psycopg://movie:movie@postgres:5432/movieai
QDRANT_URL=http://qdrant:6333
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=movieai

# ── App / autonomy ─────────────────────────────────────────────────────────
API_TOKEN=change-me
TICK_MS=2000
MAX_CONCURRENT_GENERATIONS=2
MAX_GENERATION_RETRIES=3
DAILY_TOKEN_BUDGET=2000000
DAILY_GENERATION_BUDGET=500
APPROVAL_MIN_BRIEF_MATCH=7
APPROVAL_MIN_STYLE=7
